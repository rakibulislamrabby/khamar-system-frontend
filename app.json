{
  "expo": {
    "name": "Khamar Manager",
    "slug": "khamar",
    "owner": "rakibulislamrabby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/khamar-manager-icon.png",
    "scheme": "khamarmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.rakibulislamrabby.khamar",
      "adaptiveIcon": {
        "backgroundColor": "#006A4E",
        "foregroundImage": "./assets/images/logo/khamar-manager-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/logo/khamar-manager-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo/khamar-manager.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1620ca4-35a6-4e27-a232-2708fcaa299c"
      }
    }
  }
}
